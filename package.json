{
  "name": "mqtt-scope",
  "private": true,
  "version": "0.1.0",
  "description": "Subscribe to MQTT topics and inspect every message as it arrives.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n bridge,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "serve": "node build/server/index.js",
    "start": "npm run build && npm run serve",
    "typecheck": "tsc --build --force"
  },
  "dependencies": {
    "express": "^4.19.2",
    "mqtt": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^5.3.4"
  }
}
